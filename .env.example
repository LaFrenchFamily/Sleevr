# Copie ce fichier en « .env » puis remplis-le (surtout pour l'installation sur serveur)
# Code d'invitation demandé pour créer un compte (donne-le à tes amis). Vide = inscription libre.
SIGNUP_CODE=choisis-un-code
SECRET_KEY=une-longue-chaine-aleatoire
DOMAIN=cartes.exemple.fr
# Facultatif mais recommandé : clé gratuite sur https://dev.pokemontcg.io (évite les limites de débit)
POKEMONTCG_API_KEY=
REFRESH_HOUR=6
# Facultatif : reconnaissance des cartes par l'IA (clé sur https://console.anthropic.com). Environ 1 centime par photo.
ANTHROPIC_API_KEY=
